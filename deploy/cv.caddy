# CV Workbench. Install as /etc/caddy/sites/cv.caddy, then: sudo systemctl reload caddy
# Static build in /srv/cv/site, behind the shared Google login.
# /anthropic-api/* is relayed to Anthropic, same as the Vite dev server does, so the
# browser never needs the "dangerous direct access" header. The API key stays in the
# browser (the app's settings), it is not stored on the server.
# "import datastore" gives the app the hub's document store: the CVs are saved per person at
# /api/data/cv, so the PC and the phone see the same copy.
cv.gallab.top {
    encode zstd gzip
    header {
        X-Robots-Tag "noindex, nofollow"
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    route {
        request_header -Remote-User
        request_header -Remote-Email
        request_header -Remote-Name
        request_header -Remote-Groups

        import auth
        import datastore

        handle_path /anthropic-api/* {
            reverse_proxy https://api.anthropic.com {
                header_up Host api.anthropic.com
                header_up -Remote-User
                header_up -Remote-Email
                header_up -Remote-Name
                header_up -Remote-Groups
                header_up -Cookie
            }
        }

        handle {
            root * /srv/cv/site
            try_files {path} /index.html
            file_server
        }
    }
}
