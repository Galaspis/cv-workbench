# קורות (Korot). Installed by the deploy Action as /etc/caddy/sites/cv.caddy.
# The file keeps its old name on purpose: installing it replaces the old cv.gallab.top site
# instead of adding a second file that would define the same address twice.
# Static build in /srv/cv/site, behind the shared Google login.
# /anthropic-api/* is relayed to Anthropic, same as the Vite dev server does, so the
# browser never needs the "dangerous direct access" header. The API key stays in the
# browser (the app's settings), it is not stored on the server.
# "import datastore" gives the app the hub's document store: the CVs are saved per person at
# /api/data/cv, so the PC and the phone see the same copy.
korot.gallab.top {
    encode zstd gzip
    header {
        X-Robots-Tag "noindex, nofollow"
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    route {
        request_header -Remote-User
        request_header -Remote-Email
        request_header -Remote-Name
        request_header -Remote-Groups

        # Brand files (logo, icons, manifest, fonts) are public: phones fetch them WITHOUT the
        # login cookie when adding the app to the home screen, and would otherwise get a blank icon.
        @public path /brand/*
        handle @public {
            root * /srv/cv/site
            header Cache-Control "public, max-age=86400"
            header /brand/site.webmanifest Content-Type "application/manifest+json"
            file_server
        }

        import auth
        import datastore

        handle_path /anthropic-api/* {
            reverse_proxy https://api.anthropic.com {
                header_up Host api.anthropic.com
                header_up -Remote-User
                header_up -Remote-Email
                header_up -Remote-Name
                header_up -Remote-Groups
                header_up -Cookie
            }
        }

        handle {
            root * /srv/cv/site
            try_files {path} /index.html
            file_server
        }
    }
}

# The old address. Everything moves to korot.gallab.top, keeping the path (old bookmarks work).
cv.gallab.top {
    redir https://korot.gallab.top{uri} permanent
}
